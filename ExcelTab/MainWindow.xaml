<Window x:Class="ExcelTab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExcelTab"
        xmlns:view="clr-namespace:ExcelTab.VIEW"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="MainWindow" Height="22" Width="250" MaxWidth="800"
        AllowsTransparency="False" Background="Transparent" WindowStyle="None"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewMouseWheel="Window_MouseWheel"
        >
    <Border x:Name="MainBd" Background="#2d2d30" CornerRadius="0" Margin="0" Padding="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="20" x:Name="LeftScrollWidth"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20" x:Name="RightScrollWidth"/>
            </Grid.ColumnDefinitions>
            <Border Background="#01000000" MouseDown="Border_MouseDown">
                <Border.ContextMenu>
                    <ContextMenu Style="{StaticResource ContextMenuStyle}">
                        <MenuItem x:Name="VersionMi2" Header="ExcelTab v1.0" 
                              IsCheckable="False" IsEnabled="False" IsHitTestVisible="False"
                              Style="{StaticResource MenuItemStyle}"/>
                        <!--<MenuItem Header="設定" Click="SettingBt_Click"  Style="{StaticResource MenuItemStyle}"/>-->
                        <MenuItem Header="タブ位置初期化" Click="MoveBottomBt_Click" Style="{StaticResource MenuItemStyle}"/>
                        <!--<MenuItem x:Name="TestBt" Header="テストモード" Click="TestBt_Click" Style="{StaticResource MenuItemStyle}"/>-->
                        <!--<MenuItem Header="アップデート" Click="UpdateBt_Click" Style="{StaticResource MenuItemStyle}"/>-->
                        <MenuItem Header="Windowsスタート時に自動実行" 
                              x:Name="MenuStartupBt2" Click="MenuStartupBt_Click"
                               Style="{StaticResource MenuItemStyle}"/>
                        <MenuItem Header="すべてのEXCELを強制終了" Click="ExcelKillBt_Click" Style="{StaticResource MenuItemStyle}"/>
                        <MenuItem Header="終了" Click="ExitBt_Click" Style="{StaticResource MenuItemStyle}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <icons:PackIconBoxIcons Kind="RegularMove" Foreground="Gray" Width="18" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Width="20" Height="20" Background="#01000000" MouseUp="FavoriteWindowOpen_MouseUp">
                    <icons:PackIconBoxIcons Kind="RegularBookmark" Foreground="White" Width="12" 
                                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
            <Border Grid.Column="2" Background="#01000000" MouseDown="LeftScroll_MouseDown">
                <icons:PackIconBoxIcons Kind="RegularCaretLeft" Foreground="White" Width="18" VerticalAlignment="Center"/>
            </Border>
            <ScrollViewer x:Name="TabSv" Grid.Column="3" Background="Transparent" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                <StackPanel x:Name="TabSp" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" >
                    <view:TabItemControl/>
                    <view:TabItemControl/>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="4" Background="#01000000" MouseDown="RightScroll_MouseDown">
                <icons:PackIconBoxIcons Kind="RegularCaretRight" Foreground="White" Width="18" VerticalAlignment="Center"/>
            </Border>
            
            <tb:TaskbarIcon x:Name="TaskIcon"
                    Visibility="Visible"
                    IconSource="ExcelTab2.ico"
                    MenuActivation="LeftOrRightClick"
        >
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu Style="{StaticResource ContextMenuStyle}">
                        <MenuItem x:Name="VersionMi" Header="ExcelTab v1.0" 
                              IsCheckable="False" IsEnabled="False" IsHitTestVisible="False"
                              Style="{StaticResource MenuItemStyle}"/>
                        <!--<MenuItem Header="設定" Click="SettingBt_Click"  Style="{StaticResource MenuItemStyle}"/>-->
                        <MenuItem Header="タブ位置初期化" Click="MoveBottomBt_Click" Style="{StaticResource MenuItemStyle}"/>
                        <!--<MenuItem Header="アップデート" Click="UpdateBt_Click" Style="{StaticResource MenuItemStyle}"/>-->
                        <MenuItem Header="Windowsスタート時に自動実行" 
                              x:Name="MenuStartupBt" Click="MenuStartupBt_Click"
                               Style="{StaticResource MenuItemStyle}"/>
                        <MenuItem Header="すべてのEXCELを強制終了" Click="ExcelKillBt_Click" Style="{StaticResource MenuItemStyle}"/>
                        <MenuItem Header="終了" Click="ExitBt_Click" Style="{StaticResource MenuItemStyle}" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </Grid>
    </Border>
</Window>
