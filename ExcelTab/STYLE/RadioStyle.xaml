                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Width="200" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <!--<Trigger Property="IsFocused"
                                     Value="True">
                            <Setter TargetName="EllipseMain"
                                        Property="Stroke"
                                        Value="{DynamicResource PointColor}" />
                        </Trigger>
                        <Trigger Property="IsFocused"
