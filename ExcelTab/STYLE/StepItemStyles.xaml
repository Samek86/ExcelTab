    <Style x:Key="description" TargetType="{x:Type Label}">
        <Setter Property="FontFamily" Value="Meiryo"></Setter>
        <Setter Property="FontWeight" Value="Medium"></Setter>
        <Setter Property="FontSize" Value="11"></Setter>
        <Setter Property="Height" Value="18"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource GrayColor}"></Setter>
    </Style>

    <Style x:Key="{x:Type TextBox}" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Meiryo"></Setter>
        <Setter Property="FontWeight" Value="Medium"></Setter>
        <Setter Property="FontSize" Value="12"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="Height" Value="20"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource FontColor}"></Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource StepBackgroundColor}"/>
        <Setter Property="TextWrapping" Value="Wrap"></Setter>
