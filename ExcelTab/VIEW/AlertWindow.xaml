<Window x:Class="ExcelTab.VIEW.Alert"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExcelTab.VIEW"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Alert" Height="133" Width="300" AllowsTransparency="True" MinWidth="300" MinHeight="133"
        Background="Transparent" WindowStyle="None" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" MouseDown="Window_MouseDown" KeyUp="Window_KeyUp" Topmost="True">
    
    <Border Background="{DynamicResource ReverseFontColor}" CornerRadius="4, 4, 3, 3" BorderThickness="1" BorderBrush="#FF696969" Margin="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="5" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Color="#FF747474"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource ReverseFontColor}" CornerRadius="3, 3, 0, 0">
                <Grid>
                    <Border x:Name="StateBd" Margin="10,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="13" Height="13" Background="#FFC1C1C1" CornerRadius="13"/>
                    <TextBlock x:Name="TitleTb" Style="{StaticResource TextBlockStyle}" Text="テキストボックス" Foreground="{DynamicResource FontColor}" Margin="28, 5, 30, 5" FontSize="15" FontWeight="Normal"/>
                    <icons:PackIconBoxIcons Kind="RegularX" Height="13" Foreground="{DynamicResource FontColor}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0, 9, 10, 0" MouseDown="Close_MouseDown" Cursor="Hand"/>
                </Grid>
            </Border>
            <StackPanel x:Name="MainPanel" Margin="24,10,24,10" Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="MessageTb" Style="{StaticResource TextBlockStyle}" Text="正しく入力してください。" Foreground="{DynamicResource FontColor}" Margin="5" FontSize="15" FontWeight="Normal"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="CancelBt" Content="キャンセル" Click="CancelButton_Click" Style="{StaticResource GrayBt}" Margin="5" Height="25" Width="80"/>
                    <Button x:Name="OkBt" Content="確認" Click="OKButton_Click" Style="{StaticResource MainBt}" Margin="5" Height="25" Width="80"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
