<UserControl x:Class="ExcelTab.VIEW.TabItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ExcelTab"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="200" Loaded="UserControl_Loaded" 
             Height="20" MinWidth="80" Margin="0,0,5,0" MaxWidth="250" MouseEnter="UserControl_MouseEnter"
             AllowDrop="True" Drop="UserControl_Drop"  MouseLeave="UserControl_MouseLeave"
             MouseLeftButtonDown="UserControl_MouseDown" MouseLeftButtonUp="Border_MouseLeftButtonUp"
             MouseMove="UserControl_MouseMove"
             PreviewMouseLeftButtonUp="UserControl_PreviewMouseLeftButtonUp"
             DragEnter="UserControl_DragEnter" DragLeave="UserControl_DragLeave"
             MouseRightButtonDown="TabBd_MouseRightButtonDown"
             >
    <Border x:Name="TabBd" Background="#444444" Padding="0" CornerRadius="1" 
            BorderBrush="White" BorderThickness="1"
            ToolTipService.ShowDuration="100000" ToolTipService.InitialShowDelay="100"
            ToolTipService.Placement="Top" ToolTipService.HasDropShadow="False" ToolTipService.HorizontalOffset="-200"
            >
        <Border.ToolTip>
            <StackPanel x:Name="ToolTipSp" Background="#444444" Margin="0">
                <Image x:Name="ToolTipImg" Width="900" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="ToolTipName" Foreground="White" 
                           FontSize="13" Margin="10,5"
                           FontWeight="Bold"/>
            </StackPanel>
        </Border.ToolTip>
        <Border.ContextMenu>
            <ContextMenu Style="{StaticResource ContextMenuStyle}">
                <MenuItem Header="表示名変更" Click="ViewNameChangeBt_Click" Style="{StaticResource MenuItemStyle}"/>
                <MenuItem Header="色変更" Click="SelectColorBt_Click" Style="{StaticResource MenuItemStyle}"/>
                <MenuItem Header="フォルダ開く" Click="OpenFolderBt_Click" Style="{StaticResource MenuItemStyle}"/>
                <MenuItem Header="閉じる" Click="ExcelCloseBt_Click" Style="{StaticResource MenuItemStyle}"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderThickness="0,0,1,0" BorderBrush="White" Background="#99000000">
                <TextBlock x:Name="IndexTb" Text="1" TextAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
            </Border>
            <TextBlock x:Name="FileNameTb" Grid.Column="1" Text="ファイル名" Foreground="White" FontSize="12" 
                       VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="NoWrap" Margin="5,0,5,1"
                       />
            <Border x:Name="DropBd" Grid.ColumnSpan="2" Background="{StaticResource BackgroundColor}" Visibility="Collapsed" IsHitTestVisible="True">
                <icons:PackIconBoxIcons x:Name="DropIcon" Kind="RegularLogIn" HorizontalAlignment="Center" Foreground="White" RenderTransformOrigin="0.5,0.5">
                </icons:PackIconBoxIcons>
            </Border>
        </Grid>
    </Border>
</UserControl>
